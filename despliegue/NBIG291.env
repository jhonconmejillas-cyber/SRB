# ============================================================
#  NBIG291 (10.43.99.232): clientes + gt_1 (primario) + broker_1 + RMC
#  Copiar como .env en la raiz del proyecto:  cp despliegue/NBIG291.env .env
# ============================================================

# --- IP de cada capa
#     HOST_CAPA_CONSUMIDORES es ESTA maquina: el servicio de cancelacion manda
#     los avisos a esta IP (buzon de cada cliente, puertos 5600-5699).
HOST_CAPA_CONSUMIDORES=10.43.99.232
HOST_CAPA_SERVICIOS=10.43.99.232
HOST_CAPA_PERSISTENCIA=10.43.99.237

# --- GT: los clientes empiezan en gt_1 (esta maquina) y pasan a gt_2 si falla
GT_HOSTS=10.43.99.232,10.43.100.84
GT_PUERTO_CLIENTES=5555
GT_PUERTO_CANCELACION=5557

# --- Brokers: el GT usa el de su maquina; los RMC se conectan a los dos
BROKER_HOST=127.0.0.1
BROKER_PUERTO_GT=5559
BROKER_PUERTO_RMC=5556
BROKERS=10.43.99.232,10.43.100.84

# --- Persistencia (en NBIG296)
SP_PUERTO=5558
BD_RUTA=datos/srb.db

# --- Tiempos
TIMEOUT_MS=5000

# --- Cliente: tolerancia a fallos (Lazy Pirate)
CLIENTE_TIMEOUT_MS=2500
CLIENTE_INTENTOS=6
CLIENTE_FALLOS_PARA_CAMBIAR=2
BACKOFF_BASE_MS=100
BACKOFF_MAX_MS=2000
CLIENTE_PUERTO_NOTIF_MIN=5600
CLIENTE_PUERTO_NOTIF_MAX=5699
