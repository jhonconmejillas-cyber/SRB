HOST_CAPA_CONSUMIDORES=127.0.0.1
HOST_CAPA_SERVICIOS=127.0.0.1
HOST_CAPA_PERSISTENCIA=127.0.0.1

# --- Puertos del Gestor de Transacciones (maquina de servicios)
GT_PUERTO_CLIENTES=5555
GT_PUERTO_CANCELACION=5557
# --- Replicas del GT, separadas por coma: primero gt_1 (primario), luego gt_2 (respaldo).
#     Los clientes las usan para el failover y el servicio de cancelacion escucha a todas.
#     Si no se pone, se usa solo HOST_CAPA_SERVICIOS.
GT_HOSTS=127.0.0.1

# --- Broker ROUTER/DEALER (uno en cada maquina de negocio)
#     El GT se conecta al broker de SU maquina; los RMC se conectan a TODOS los brokers.
BROKER_HOST=127.0.0.1
BROKER_PUERTO_GT=5559
BROKER_PUERTO_RMC=5556
BROKERS=127.0.0.1

# --- Servicio de Persistencia (maquina de persistencia)
SP_PUERTO=5558
BD_RUTA=datos/srb.db

# --- Tiempo maximo de espera de una respuesta, en milisegundos
TIMEOUT_MS=5000
# --- Rango de puertos donde cada cliente recibe los avisos de cancelacion
#     (abrirlos en el firewall de la maquina de clientes). Opcional.
CLIENTE_PUERTO_NOTIF_MIN=5600
CLIENTE_PUERTO_NOTIF_MAX=5699

# --- Tolerancia a fallos del cliente (Lazy Pirate). Opcionales.
#     Espera por intento, intentos maximos, fallos seguidos antes de pasar al otro GT,
#     y retroceso exponencial entre intentos (100, 200, 400... hasta el maximo).
CLIENTE_TIMEOUT_MS=2500
CLIENTE_INTENTOS=6
CLIENTE_FALLOS_PARA_CAMBIAR=2
BACKOFF_BASE_MS=100
BACKOFF_MAX_MS=2000
